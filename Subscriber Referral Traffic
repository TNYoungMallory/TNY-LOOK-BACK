SET ansi_mode = false;

WITH params AS (
  SELECT
    date_sub(next_day(current_date - 1, 'Sun'), 8) AS start_date,
    date_sub(next_day(current_date - 1, 'Sun'), 2) AS end_date
),
content AS (
  SELECT
    l.id,
    l.hed,
    l.original_author,
    l.channel AS site_section,
    l.original_pub_date
  FROM
    gold_us_prod.content.gld_cross_brand_live l
  WHERE
    lower(l.full_url) NOT LIKE '%verso%'
    AND lower(l.hed) NOT LIKE '%crossword%'
    AND lower(l.hed) NOT LIKE '%shuffalo%'
    AND lower(l.hed) NOT LIKE '%puzzles%'
    AND lower(l.hed) NOT LIKE '%games%'
    AND lower(l.hed) NOT LIKE '%catalogues%'
    AND lower(l.hed) NOT IN ('the new yorker', 'page not found', 'my account')
    AND l.type = 'article'
),
subs AS (
  SELECT DISTINCT
    visit_date,
    amgid
  FROM
    gold_us_prod.area_shared_analytics.subscribers_tny CROSS JOIN params p
  WHERE
    visit_date BETWEEN p.start_date AND p.end_date
    AND amgid IS NOT NULL
),
web_traffic AS (
  SELECT
    wpv.content.id AS post_id,
    wpv.domain_sessionid,
    wpv.user.amgid AS user_amgid,
    DATE(wpv.derived_tstamp) AS visit_dt,
    wpv.traffic.referer_source,
    wpv.traffic.referer_url_host,
    wpv.traffic.referer_medium,
    wpv.traffic.source_channel_group
  FROM
    gold_us_prod.spruce.gld_web_page_views wpv CROSS JOIN params p
  WHERE
    wpv.app_id = 'the-new-yorker'
    AND DATE(wpv.derived_tstamp) BETWEEN p.start_date AND p.end_date
    AND lower(wpv.page.url) NOT LIKE '%verso%'
    AND wpv.user.amgid IS NOT NULL
),
sub_web AS (
  SELECT
    w.*
  FROM
    web_traffic w
      INNER JOIN subs s
        ON w.user_amgid = s.amgid
        AND w.visit_dt = s.visit_date
),
app_traffic AS (
  SELECT
    msv.page.content_id AS post_id,
    msv.session_id AS domain_sessionid,
    msv.user.amg_id AS user_amgid,
    DATE(msv.derived_tstamp) AS visit_dt,
    NULL AS referer_source,
    NULL AS referer_url_host,
    NULL AS referer_medium,
    'Direct' AS source_channel_group
  FROM
    gold_us_prod.spruce.gld_mobile_screen_views msv CROSS JOIN params p
  WHERE
    msv.app_id = 'the-new-yorker-app'
    AND DATE(msv.derived_tstamp) BETWEEN p.start_date AND p.end_date
    AND msv.user.amg_id IS NOT NULL
),
sub_app AS (
  SELECT
    a.*
  FROM
    app_traffic a
      INNER JOIN subs s
        ON a.user_amgid = s.amgid
        AND a.visit_dt = s.visit_date
),
traffic AS (
  SELECT
    *
  FROM
    sub_web
  UNION ALL
  SELECT
    *
  FROM
    sub_app
),
traffic_mapped AS (
  SELECT
    t.*,
    CASE
      WHEN
        referer_source IS NULL
        OR referer_source = ''
      THEN
        'Direct'
      WHEN
        source_channel_group = 'Organic Search'
        OR (
          (
            lower(referer_source) = 'google'
            AND referer_medium = 'search'
          )
          OR lower(referer_source) LIKE '%bing%'
          OR lower(referer_source) LIKE '%duckduckgo%'
          OR lower(referer_source) LIKE '%yahoo%'
        )
      THEN
        'Organic Search'
      WHEN
        source_channel_group = 'Email'
        OR lower(referer_source) LIKE '%nl%'
      THEN
        'Newsletter'
      WHEN source_channel_group = 'Organic Social' THEN 'Organic Social'
      WHEN lower(referer_source) LIKE '%facebook%' THEN 'Facebook'
      WHEN lower(referer_source) LIKE '%youtube%' THEN 'YouTube'
      WHEN
        lower(referer_source) LIKE '%twitter%'
        OR referer_url_host LIKE '%t.co%'
      THEN
        'Twitter'
      WHEN lower(referer_source) LIKE '%instagram%' THEN 'Instagram'
      WHEN referer_url_host LIKE '%threads%' THEN 'Threads'
      WHEN lower(referer_source) LIKE '%linkedin%' THEN 'LinkedIn'
      WHEN
        lower(referer_source) LIKE '%chatgpt%'
        OR lower(referer_source) LIKE '%perplexity%'
        OR lower(referer_source) LIKE '%gemini%'
        OR lower(referer_source) LIKE '%copilot%'
        OR lower(referer_source) LIKE '%claude%'
        OR referer_url_host LIKE '%openai.com%'
      THEN
        'AI Assistants'
      WHEN
        lower(referer_source) LIKE '%bluesky%'
        OR referer_url_host LIKE '%bsky.app%'
      THEN
        'Bluesky'
      WHEN
        lower(referer_source) LIKE '%hacker%news%'
        OR referer_url_host LIKE '%news.ycombinator.com%'
      THEN
        'Hacker News'
      WHEN
        lower(referer_source) LIKE '%tiktok%'
        OR referer_url_host LIKE '%tiktok.com%'
        OR lower(referer_source) LIKE '%likeshop%'
        OR referer_url_host LIKE '%likeshop%'
      THEN
        'TikTok'
      ELSE 'Other'
    END AS mapped_source
  FROM
    traffic t
),
story_traffic AS (
  SELECT
    c.hed,
    c.original_author,
    c.site_section,
    c.original_pub_date,
    t.domain_sessionid,
    t.mapped_source
  FROM
    traffic_mapped t
      JOIN content c
        ON t.post_id = c.id
),
story_upvs AS (
  SELECT
    hed,
    original_author,
    site_section,
    original_pub_date,
    mapped_source,
    COUNT(DISTINCT domain_sessionid) AS upvs
  FROM
    story_traffic
  GROUP BY
    1,
    2,
    3,
    4,
    5
),
story_totals AS (
  SELECT
    hed,
    SUM(upvs) AS total_upvs
  FROM
    story_upvs
  GROUP BY
    1
),
top_stories AS (
  SELECT
    hed,
    total_upvs
  FROM
    story_totals
  ORDER BY
    total_upvs DESC
  LIMIT 20
)
SELECT
  u.hed,
  u.original_author,
  u.site_section,
  u.original_pub_date,
  u.mapped_source,
  u.upvs,
  ts.total_upvs
FROM
  top_stories ts
    JOIN story_upvs u
      ON ts.hed = u.hed
ORDER BY
  ts.total_upvs DESC,
  u.upvs DESC
