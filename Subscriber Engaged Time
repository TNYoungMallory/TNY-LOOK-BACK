SET ansi_mode = false;

WITH params AS (
  SELECT
    NEXT_DAY(CURRENT_DATE - INTERVAL 8 DAYS, 'Sun') - INTERVAL 7 DAYS AS start_date,
    NEXT_DAY(CURRENT_DATE - INTERVAL 8 DAYS, 'Sun') - INTERVAL 1 DAY AS end_date
),
content AS (
  SELECT
    l.id,
    l.hed,
    l.original_author,
    l.channel AS site_section,
    l.original_pub_date
  FROM
    gold_us_prod.content.gld_cross_brand_live l
  WHERE
    lower(l.full_url) NOT LIKE '%verso%'
    AND lower(l.hed) NOT LIKE '%crossword%'
    AND lower(l.hed) NOT LIKE '%shuffalo%'
    AND lower(l.hed) NOT LIKE '%puzzles%'
    AND lower(l.hed) NOT LIKE '%games%'
    AND lower(l.hed) NOT LIKE '%catalogues%'
    AND lower(l.hed) NOT IN ('the new yorker', 'page not found', 'my account')
    AND l.type = 'article'
),
subs AS (
  SELECT DISTINCT
    visit_date,
    amgid
  FROM
    gold_us_prod.area_shared_analytics.subscribers_tny CROSS JOIN params p
  WHERE
    visit_date BETWEEN p.start_date AND p.end_date
    AND amgid IS NOT NULL
),
web_traffic AS (
  SELECT
    wpv.content.id AS post_id,
    wpv.domain_sessionid,
    wpv.user.amgid AS user_amgid,
    DATE(wpv.derived_tstamp) AS visit_dt,
    wpv.page_engaged_time_in_s,
    wpv.video_engaged_time_in_s,
    wpv.audio_engaged_time_in_s
  FROM
    gold_us_prod.spruce.gld_web_page_views wpv CROSS JOIN params p
  WHERE
    wpv.app_id = 'the-new-yorker'
    AND DATE(wpv.derived_tstamp) BETWEEN p.start_date AND p.end_date
    AND lower(wpv.page.url) NOT LIKE '%verso%'
    AND lower(wpv.page.url) NOT LIKE '%utm_medium=display%'
    AND lower(wpv.page.url) NOT LIKE '%utm_medium=cpc%'
    AND lower(wpv.page.url) NOT LIKE '%utm_campaign=paid%'
    AND lower(wpv.page.url) NOT LIKE '%utm_social-type=paid%'
    AND lower(wpv.page.url) NOT LIKE '%utm_campaign=cm_paid%'
    AND lower(wpv.page.url) NOT LIKE '%utm_campaign=fbig_direct%'
    AND lower(wpv.page.url) NOT LIKE '%utm_campaign=domestic_prospecting%'
    AND lower(wpv.page.url) NOT LIKE '%source=paid%'
    AND wpv.traffic.source_channel_group NOT IN ('Paid Social', 'Paid Search')
    AND wpv.user.amgid IS NOT NULL
),
sub_web AS (
  SELECT
    w.*
  FROM
    web_traffic w
      INNER JOIN subs s
        ON w.user_amgid = s.amgid
        AND w.visit_dt = s.visit_date
),
app_traffic AS (
  SELECT
    msv.page.content_id AS post_id,
    msv.session_id AS domain_sessionid,
    msv.user.amg_id AS user_amgid,
    DATE(msv.derived_tstamp) AS visit_dt,
    msv.screen_engaged_time_in_s AS page_engaged_time_in_s,
    0 AS video_engaged_time_in_s,
    msv.audio_engaged_time_in_s
  FROM
    gold_us_prod.spruce.gld_mobile_screen_views msv CROSS JOIN params p
  WHERE
    msv.app_id = 'the-new-yorker-app'
    AND DATE(msv.derived_tstamp) BETWEEN p.start_date AND p.end_date
    AND msv.user.amg_id IS NOT NULL
),
sub_app AS (
  SELECT
    a.*
  FROM
    app_traffic a
      INNER JOIN subs s
        ON a.user_amgid = s.amgid
        AND a.visit_dt = s.visit_date
),
traffic AS (
  SELECT
    *
  FROM
    sub_web
  UNION ALL
  SELECT
    *
  FROM
    sub_app
),
story_traffic AS (
  SELECT
    c.hed,
    c.original_author,
    c.site_section,
    c.original_pub_date,
    t.page_engaged_time_in_s,
    t.video_engaged_time_in_s,
    t.audio_engaged_time_in_s
  FROM
    traffic t
      JOIN content c
        ON t.post_id = c.id
),
story_performance AS (
  SELECT
    hed,
    original_author,
    site_section,
    original_pub_date,
    SUM(COALESCE(page_engaged_time_in_s, 0)) / 60 AS engaged_page_minutes,
    SUM(COALESCE(video_engaged_time_in_s, 0)) / 60 AS engaged_video_minutes,
    SUM(COALESCE(audio_engaged_time_in_s, 0)) / 60 AS engaged_audio_minutes,
    (
      SUM(COALESCE(page_engaged_time_in_s, 0))
        + SUM(COALESCE(video_engaged_time_in_s, 0))
        + SUM(COALESCE(audio_engaged_time_in_s, 0))
    )
      / 60 AS total_engaged_minutes
  FROM
    story_traffic
  WHERE
    original_pub_date >= CURRENT_DATE - INTERVAL 21 DAYS
  GROUP BY
    hed,
    original_author,
    site_section,
    original_pub_date
),
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (ORDER BY total_engaged_minutes DESC) AS rank
  FROM
    story_performance
)
SELECT
  rank,
  hed,
  original_author,
  site_section,
  original_pub_date,
  total_engaged_minutes,
  engaged_page_minutes,
  engaged_video_minutes,
  engaged_audio_minutes
FROM
  ranked
WHERE
  rank <= 20
ORDER BY
  rank
